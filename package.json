{
  "name": "gigachad-grc",
  "private": true,
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "workspaces": [
    "services/shared",
    "services/controls",
    "services/frameworks",
    "services/policies",
    "services/tprm",
    "services/trust",
    "services/audit",
    "frontend"
  ],
  "scripts": {
    "prepare": "husky",
    "setup": "npm run db:generate && npm run prepare",
    "db:generate": "npm run prisma:generate --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "validate:production": "./scripts/validate-production.sh",
    "validate:production:strict": "./scripts/validate-production.sh --strict",
    "backup": "./deploy/backup.sh",
    "restore": "./deploy/restore.sh",
    "ci:build:frontend": "npm --workspace frontend run build:typecheck",
    "ci:analyze:frontend": "npm --workspace frontend run build:analyze",
    "test:load": "./tests/load/run-load-tests.sh",
    "test:load:smoke": "./tests/load/run-load-tests.sh smoke",
    "test:load:load": "./tests/load/run-load-tests.sh load",
    "test:load:stress": "./tests/load/run-load-tests.sh stress",
    "test:load:spike": "./tests/load/run-load-tests.sh spike",
    "test:load:soak": "./tests/load/run-load-tests.sh soak",
    "test:load:all": "./tests/load/run-load-tests.sh all",
    "test:load:quick": "./tests/load/run-load-tests.sh quick"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/testing": "11.2.5",
    "exceljs": "4.4.0",
    "multer": "2.4.0",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@types/jest": "^30.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^14.0.0",
    "husky": "^9.0.0",
    "jest": "^30.5.2",
    "lint-staged": "^15.0.0",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.12",
    "typescript-eslint": "^8.62.1",
    "vitest": "5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "broadcast-channel": {
      "@babel/runtime": "^7.26.10"
    },
    "minipass": "^7.1.2",
    "@isaacs/brace-expansion": "^5.0.0",
    "brace-expansion": "^5.0.9",
    "lodash": ">=4.18.0",
    "fast-xml-parser": ">=5.7.0",
    "fast-xml-builder": ">=1.2.0",
    "fast-uri": "^4.1.3",
    "axios": ">=1.15.2",
    "minimatch": "^10.2.3",
    "rollup": "^4.59.0",
    "@smithy/config-resolver": "^4.4.0",
    "multer": "$multer",
    "serialize-javascript": ">=7.0.3",
    "file-type": ">=21.3.4",
    "handlebars": ">=4.7.9",
    "path-to-regexp": ">=8.4.0",
    "picomatch": ">=2.3.2",
    "@xmldom/xmldom": "0.8.15",
    "nodemailer": "^9.1.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.26",
    "yaml": ">=2.8.3",
    "sanitize-html": "2.17.7",
    "follow-redirects": ">=1.16.0",
    "uuid": "$uuid",
    "js-yaml": "^4.3.2",
    "qs": "^6.16.0",
    "browserslist": "^4.28.9",
    "baseline-browser-mapping": "^2.11.23",
    "postcss-selector-parser": "^6.1.4",
    "@nestjs/swagger": {
      "js-yaml": "4.3.2"
    },
    "@nestjs/platform-express@11.2.1": {
      "multer": "$multer"
    },
    "exceljs@4.4.0": {
      "uuid": "11.1.1"
    },
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    },
    "@nestjs/cli": {
      "@angular-devkit/core": {
        "ajv": "8.18.0"
      },
      "@nestjs/schematics": {
        "@angular-devkit/core": {
          "ajv": "8.18.0"
        }
      }
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^9.0.7"
    }
  }
}
