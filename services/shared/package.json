{
  "name": "@gigachad-grc/shared",
  "version": "1.0.0",
  "description": "Shared types, utilities, and middleware for GigaChad GRC platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.js --runInBand src/auth/jwt.guard.spec.ts src/auth/application-auth.guard.spec.ts src/watermark/watermark.service.spec.ts",
    "test:auth": "npm test",
    "clean": "rm -rf dist",
    "prepublish": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.450.0",
    "@azure/storage-blob": "^12.17.0",
    "@infisical/sdk": "^5.0.2",
    "@nestjs/throttler": "^6.7.0",
    "class-transformer": "^0.5.1",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.1.0",
    "pdfkit": "^0.18.0",
    "sanitize-html": "2.17.7",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.19.39",
    "@types/pdfkit": "^0.17.5",
    "@types/sanitize-html": "^2.16.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.3.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1"
  },
  "files": [
    "dist",
    "vendor"
  ],
  "license": "MIT",
  "overrides": {
    "fast-xml-parser": ">=5.5.7",
    "path-to-regexp": ">=8.4.0",
    "picomatch": ">=2.3.2",
    "brace-expansion": ">=5.0.5",
    "lodash": ">=4.18.0",
    "uuid": ">=11.1.1",
    "js-yaml": "^4.3.2"
  }
}
